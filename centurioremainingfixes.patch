-+# Runs the suite on every push and pull request. The pure-logic tests (store,
-+# discovery, colours, queries) need nothing but the standard library; the UI
-+# tests need Flet. Flet is installed as a hard requirement here — a failed
-+# install fails the job — and the suite itself refuses to report success if
-+# a UI test still skipped under CI, so a partial/broken install can't pass
-+# silently either.
-+on:
-+  push:
-+    branches: ["**"]
-+  pull_request:
-+
-+jobs:
-+  test:
-+    runs-on: ubuntu-latest
-+    steps:
-+      - uses: actions/checkout@v4
-+
-+      - name: Set up Python
-+        uses: actions/setup-python@v5
-+        with:
-+          python-version: "3.12"
-+
-+      - name: Install dependencies
-+        run: pip install -r requirements.txt
-+
-+      - name: Run test suite
-+        run: python tests/test_centurio.py
